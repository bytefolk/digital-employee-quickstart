{
  "employee": {
    "id": "team-answer",
    "displayName": "__DISPLAY_NAME__",
    "profile": "answer-agent"
  },
  "runtime": {
    "readOnly": true,
    "topK": 6,
    "minScore": 0.1
  },
  "channel": {
    "type": "dingtalk",
    "clientIdEnv": "DINGTALK_CLIENT_ID",
    "clientSecretEnv": "DINGTALK_CLIENT_SECRET"
  },
  "model": {
    "provider": "openai-compatible",
    "baseUrl": "__MODEL_BASE_URL__",
    "apiKeyEnv": "OPENAI_API_KEY",
    "model": "__MODEL_NAME__"
  },
  "sources": [
    {
      "id": "team-knowledge",
      "type": "filesystem",
      "root": "__KNOWLEDGE_ROOT__",
      "include": [
        ".md"
      ]
    }
  ],
  "escalation": {
    "threshold": 0.3,
    "message": "__ESCALATION_MESSAGE__"
  }
}
