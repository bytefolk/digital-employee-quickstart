{
  "$schema": "https://raw.githubusercontent.com/bytefolk/digital-employee/main/configs/employee-package.schema.json",
  "schemaVersion": "employee-package.v1alpha1",
  "name": "team-qa",
  "version": "1.0.0",
  "description": "IT team Q&A bot — answers from team handbook, escalates when unsure.",
  "license": "Apache-2.0",
  "authors": ["ByteFolk"],
  "host": {
    "protocol": "agent-host.v1",
    "requiredCapabilities": []
  },
  "entrypoints": {
    "skill": "./SKILL.md",
    "inputSchema": "./schemas/input.schema.json",
    "outputSchema": "./schemas/output.schema.json"
  },
  "policy": {
    "mode": "read_only",
    "network": "deny",
    "filesystem": { "read": ["./knowledge/**"], "write": [] },
    "mcpTools": []
  },
  "assets": [
    "./knowledge/团队手册.md",
    "./knowledge/值班制度.md",
    "./knowledge/权限管理.md",
    "./evals/cases.json"
  ]
}
