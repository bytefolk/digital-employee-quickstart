{
  "$schema": "https://raw.githubusercontent.com/bytefolk/digital-employee/main/configs/employee-package.schema.json",
  "schemaVersion": "employee-package.v1alpha1",
  "name": "product-faq",
  "version": "1.0.0",
  "description": "Customer-facing product FAQ bot — answers from public documentation only.",
  "license": "Apache-2.0",
  "authors": ["fullstack-ai-infra"],
  "host": {
    "protocol": "agent-host.v1",
    "requiredCapabilities": []
  },
  "entrypoints": {
    "skill": "./SKILL.md",
    "inputSchema": "./schemas/input.schema.json",
    "outputSchema": "./schemas/output.schema.json"
  },
  "policy": {
    "mode": "read_only",
    "network": "deny",
    "filesystem": { "read": ["./knowledge/**"], "write": [] },
    "mcpTools": []
  },
  "assets": [
    "./knowledge/产品介绍.md",
    "./knowledge/定价方案.md",
    "./knowledge/常见问题.md",
    "./evals/cases.json"
  ]
}
