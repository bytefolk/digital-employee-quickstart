{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["customerMessage"],
  "properties": {
    "customerMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "channel": { "enum": ["chat", "email", "web_form", "phone", "other"] },
        "language": { "type": "string", "minLength": 2, "maxLength": 8 },
        "receivedAt": { "type": "string", "format": "date-time" }
      }
    },
    "conversationHistory": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "text"],
        "properties": {
          "role": { "enum": ["customer", "agent"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
          "at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "productContext": {
      "type": "string",
      "maxLength": 200,
      "description": "Which product or plan the customer is on, when the caller already knows it."
    },
    "kbSnapshot": {
      "description": "Entries returned by the knowledge-base connector, supplied by a caller that pre-fetched them (or captured for an offline contract run). At runtime the employee retrieves through the connector instead. Absent or empty here plus an absent connector means every request escalates with no_kb.",
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry", "text"],
        "properties": {
          "entry": { "type": "string", "minLength": 1, "maxLength": 200 },
          "text": { "type": "string", "minLength": 1, "maxLength": 5000 },
          "updatedAt": { "type": "string", "format": "date-time" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
