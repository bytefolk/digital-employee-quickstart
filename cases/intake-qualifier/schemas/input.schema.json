{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["requester"],
  "properties": {
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization"],
      "properties": {
        "organization": { "type": "string", "minLength": 1, "maxLength": 200 },
        "suppliedContext": {
          "type": "string",
          "maxLength": 20000,
          "description": "Caller-supplied text about the requester and the engagement (notes, referral context, prior communication). The package stays offline; enrichment beyond this text happens only through the web-search connector."
        },
        "language": { "type": "string", "minLength": 2, "maxLength": 8 }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "expectedResult": { "type": "string", "maxLength": 5000 },
        "budgetHint": {
          "type": "string",
          "maxLength": 500,
          "description": "The requester's own stated budget words, if any. A qualification signal only; the employee never computes or outputs a price."
        },
        "expectedDate": { "type": "string", "maxLength": 120 },
        "referenceUrl": { "type": "string", "maxLength": 2000 },
        "channel": { "enum": ["email", "phone", "chat", "web_form", "event", "referral", "other"] },
        "receivedAt": { "type": "string", "format": "date-time" }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 50000 },
        "source": { "enum": ["dingtalk_minutes", "zoom", "teams", "phone", "other"] },
        "occurredAt": { "type": "string", "format": "date-time" }
      }
    },
    "proposalTarget": {
      "description": "Which intake object this run should write back to. The write itself goes only through the intake connector; this field never carries record content.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordType": { "enum": ["intake_proposal", "activity"] },
        "operation": { "enum": ["create", "update"] },
        "externalId": { "type": "string", "maxLength": 128 }
      }
    }
  }
}
