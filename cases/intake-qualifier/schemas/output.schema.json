{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intakeAssessment",
    "proposalDraft",
    "meetingExtraction",
    "proposalSync",
    "requiresApproval",
    "degraded",
    "evidence"
  ],
  "properties": {
    "intakeAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "signals", "reasoning"],
      "properties": {
        "band": { "enum": ["accept", "clarify", "decline", "out_of_scope", "insufficient_input"] },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "signals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["budget", "authority", "need", "timeline"],
          "properties": {
            "budget": { "enum": ["known", "unknown", "insufficient", "not_applicable"] },
            "authority": { "enum": ["confirmed", "likely", "unknown", "none"] },
            "need": { "enum": ["explicit", "implicit", "unclear", "none"] },
            "timeline": { "enum": ["immediate", "quarter", "half_year", "unknown", "none"] }
          }
        },
        "reasoning": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "proposalDraft": {
      "description": "A scope-only acceptance proposal for a human admin. The schema deliberately has NO price, amount, currency, discount or delivery-date field: additionalProperties is false, so a price cannot be carried even by accident. Pricing and deadline commitment are human decisions.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["clarifyingQuestions"],
      "properties": {
        "scope": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "deliverables": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "criteria": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "clarifyingQuestions": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "meetingExtraction": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["commitments", "objections", "nextActions"],
      "properties": {
        "commitments": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement"],
            "properties": {
              "statement": { "type": "string", "minLength": 1, "maxLength": 500 },
              "owner": { "type": "string", "maxLength": 120 },
              "dueBy": { "type": "string", "format": "date-time" },
              "excerpt": { "type": "string", "maxLength": 500 }
            }
          }
        },
        "objections": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement"],
            "properties": {
              "statement": { "type": "string", "minLength": 1, "maxLength": 500 },
              "kind": { "enum": ["price", "timing", "capability", "authority", "competitor", "other"] },
              "excerpt": { "type": "string", "maxLength": 500 }
            }
          }
        },
        "nextActions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement"],
            "properties": {
              "statement": { "type": "string", "minLength": 1, "maxLength": 500 },
              "owner": { "type": "string", "maxLength": 120 },
              "dueBy": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "proposalSync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recordRef"],
      "properties": {
        "status": { "enum": ["synced", "degraded", "not_requested"] },
        "reason": { "enum": ["intake_connector_absent", "intake_write_rejected", "intake_write_pending_approval"] },
        "recordRef": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "requiresApproval": { "const": true },
    "degraded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "reason"],
        "properties": {
          "capability": { "enum": ["proposal_write", "enrichment"] },
          "reason": { "enum": ["intake_connector_absent", "intake_write_rejected", "web_search_connector_absent"] },
          "note": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source"],
        "properties": {
          "source": { "enum": ["input", "knowledge", "connector"] },
          "excerpt": { "type": "string", "maxLength": 500 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "proposalSync": { "properties": { "status": { "const": "degraded" } } } } },
      "then": { "properties": { "proposalSync": { "required": ["reason"], "properties": { "recordRef": { "type": "null" } } } } }
    },
    {
      "if": { "properties": { "proposalSync": { "properties": { "status": { "const": "synced" } } } } },
      "then": { "properties": { "proposalSync": { "properties": { "recordRef": { "type": "string", "minLength": 1 } } } } }
    },
    {
      "if": { "properties": { "proposalSync": { "properties": { "status": { "const": "not_requested" } } } } },
      "then": { "properties": { "proposalSync": { "properties": { "recordRef": { "type": "null" } } } } }
    }
  ]
}
