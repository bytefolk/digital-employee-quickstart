{
  "schemaVersion": "workbench-permissions.v1",
  "model": "chmod-inspired",
  "defaultEffect": "deny",
  "tools": [
    "Read",
    "Write",
    "Edit",
    "Grep",
    "Glob"
  ],
  "rules": [
    {
      "scope": "workspace",
      "resource": "./knowledge/**",
      "actions": [
        "read"
      ]
    },
    {
      "scope": "workspace",
      "resource": "./context/**",
      "actions": [
        "read"
      ]
    },
    {
      "scope": "workspace",
      "resource": "./work/deq-docs/**",
      "actions": [
        "read",
        "write"
      ]
    }
  ],
  "skills": [],
  "mcpServers": []
}
