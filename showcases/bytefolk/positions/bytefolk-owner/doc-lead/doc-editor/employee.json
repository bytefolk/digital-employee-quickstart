{
  "$schema": "https://raw.githubusercontent.com/bytefolk/digital-employee/main/configs/employee-package.schema.json",
  "schemaVersion": "employee-package.v1alpha1",
  "name": "doc-editor",
  "version": "0.1.0",
  "description": "负责协同编辑器的集成、文档渲染与上游编辑器打通。",
  "license": "Apache-2.0",
  "authors": [
    "ByteFolk"
  ],
  "host": {
    "protocol": "agent-host.v1",
    "requiredCapabilities": []
  },
  "entrypoints": {
    "skill": "./SKILL.md",
    "inputSchema": "./schemas/input.schema.json",
    "outputSchema": "./schemas/output.schema.json"
  },
  "policy": {
    "mode": "approval_required",
    "network": "deny",
    "filesystem": {
      "read": [
        "./knowledge/**",
        "./context/**"
      ],
      "write": [
        "./work/doc-editor/**"
      ]
    },
    "mcpTools": []
  },
  "assets": [
    "./knowledge/README.md",
    "./permissions.json",
    "./skills.json",
    "./mcp.json",
    "./evals/cases.json"
  ]
}
