{
  "$schema": "https://raw.githubusercontent.com/bytefolk/digital-employee/main/configs/employee-package.schema.json",
  "schemaVersion": "employee-package.v1alpha1",
  "name": "roleweave-design",
  "version": "0.1.0",
  "description": "负责客户端的交互与视觉设计，产出设计规格、走查与可用性建议，并对齐 design-system。",
  "license": "Apache-2.0",
  "authors": [
    "ByteFolk"
  ],
  "host": {
    "protocol": "agent-host.v1",
    "requiredCapabilities": []
  },
  "entrypoints": {
    "skill": "./SKILL.md",
    "inputSchema": "./schemas/input.schema.json",
    "outputSchema": "./schemas/output.schema.json"
  },
  "policy": {
    "mode": "read_only",
    "network": "deny",
    "filesystem": {
      "read": [
        "./knowledge/**",
        "./context/**"
      ],
      "write": []
    },
    "mcpTools": []
  },
  "assets": [
    "./knowledge/README.md",
    "./permissions.json",
    "./skills.json",
    "./mcp.json",
    "./evals/cases.json"
  ]
}
