{
  "$schema": "https://raw.githubusercontent.com/bytefolk/digital-employee/main/configs/employee-package.schema.json",
  "schemaVersion": "employee-package.v1alpha1",
  "name": "ui-ux-designer",
  "version": "0.1.0",
  "description": "describe pages, interactions, and states using approved design rules",
  "license": "Apache-2.0",
  "authors": [
    "ByteFolk"
  ],
  "host": {
    "protocol": "agent-host.v1",
    "requiredCapabilities": []
  },
  "entrypoints": {
    "skill": "./SKILL.md",
    "inputSchema": "./schemas/input.schema.json",
    "outputSchema": "./schemas/output.schema.json"
  },
  "policy": {
    "mode": "approval_required",
    "network": "host_policy",
    "filesystem": {
      "read": [
        "./**"
      ],
      "write": [
        "./**"
      ]
    },
    "mcpTools": []
  },
  "assets": [
    "./knowledge/README.md",
    "./knowledge/design-review-checklist.md",
    "./playbooks/task.md",
    "./evals/cases.json"
  ]
}
