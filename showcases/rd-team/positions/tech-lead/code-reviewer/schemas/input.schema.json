{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "message"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifactRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvedScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
