{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "schemaVersion",
    "summary",
    "sourceRefs",
    "caseRefs",
    "assumptions",
    "risks",
    "artifacts",
    "checks",
    "handoffQuestions",
    "findings"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "review-report.v1"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "caseRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "status",
          "evidence"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "handoffQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "file",
          "evidence",
          "action"
        ],
        "properties": {
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "file": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      }
    }
  }
}
