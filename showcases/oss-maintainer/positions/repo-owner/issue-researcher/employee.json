{
  "$schema": "https://raw.githubusercontent.com/bytefolk/digital-employee/main/configs/employee-package.schema.json",
  "schemaVersion": "employee-package.v1alpha1",
  "name": "issue-researcher",
  "version": "1.0.0",
  "description": "Issue researcher — clusters issues, finds duplicates and unassigned reports, summarizes user feedback. Facts only, no product decisions.",
  "license": "Apache-2.0",
  "authors": ["ByteFolk"],
  "host": {
    "protocol": "agent-host.v1",
    "requiredCapabilities": []
  },
  "entrypoints": {
    "skill": "./SKILL.md",
    "inputSchema": "./schemas/input.schema.json",
    "outputSchema": "./schemas/output.schema.json"
  },
  "policy": {
    "mode": "read_only",
    "network": "deny",
    "filesystem": { "read": ["./knowledge/**"], "write": [] },
    "mcpTools": []
  },
  "assets": [
    "./knowledge/issue-snapshot.md",
    "./knowledge/user-feedback.md",
    "./evals/cases.json"
  ]
}
