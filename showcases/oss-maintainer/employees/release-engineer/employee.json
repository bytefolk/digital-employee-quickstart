{
  "$schema": "https://raw.githubusercontent.com/fullstack-ai-infra/digital-employee/main/configs/employee-package.schema.json",
  "schemaVersion": "employee-package.v1alpha1",
  "name": "release-engineer",
  "version": "1.0.0",
  "description": "Release engineer — drafts release plans and checklists from the roadmap and process. Never executes a release (read-only, no network).",
  "license": "Apache-2.0",
  "authors": ["fullstack-ai-infra"],
  "host": {
    "protocol": "agent-host.v1",
    "requiredCapabilities": []
  },
  "entrypoints": {
    "skill": "./SKILL.md",
    "inputSchema": "./schemas/input.schema.json",
    "outputSchema": "./schemas/output.schema.json"
  },
  "policy": {
    "mode": "read_only",
    "network": "deny",
    "filesystem": { "read": ["./knowledge/**"], "write": [] },
    "mcpTools": []
  },
  "assets": [
    "./knowledge/release-process.md",
    "./knowledge/release-checklist.md",
    "./knowledge/release-history.md",
    "./evals/cases.json"
  ]
}
