{
  "$schema": "https://raw.githubusercontent.com/fullstack-ai-infra/digital-employee/main/configs/employee-package.schema.json",
  "schemaVersion": "employee-package.v1alpha1",
  "name": "community-operator",
  "version": "1.0.0",
  "description": "Community operator — drafts FAQ updates, announcements, and reply templates from the community digest. Text drafts only, never publishes to external channels.",
  "license": "Apache-2.0",
  "authors": ["fullstack-ai-infra"],
  "host": {
    "protocol": "agent-host.v1",
    "requiredCapabilities": []
  },
  "entrypoints": {
    "skill": "./SKILL.md",
    "inputSchema": "./schemas/input.schema.json",
    "outputSchema": "./schemas/output.schema.json"
  },
  "policy": {
    "mode": "read_only",
    "network": "deny",
    "filesystem": { "read": ["./knowledge/**"], "write": [] },
    "mcpTools": []
  },
  "assets": [
    "./knowledge/community-digest.md",
    "./knowledge/activity-record.md",
    "./knowledge/faq-templates.md",
    "./evals/cases.json"
  ]
}
