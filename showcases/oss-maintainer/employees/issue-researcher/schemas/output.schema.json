{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "answer": { "type": "string" },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "uri": { "type": "string" }
        },
        "required": ["label"]
      }
    },
    "escalation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "reason": { "type": "string" },
            "target": { "type": "string" }
          },
          "required": ["reason"]
        }
      ]
    }
  },
  "required": ["answer"]
}
