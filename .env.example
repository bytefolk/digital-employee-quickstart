# 复制这个文件为 .env，然后填写下面的值。
#
#     cp .env.example .env
#
# .env 已经被 .gitignore 排除，不会被上传到 GitHub。
# 千万不要把填好的 .env 发给别人或提交到代码仓库。

# ── 钉钉应用凭证 ─────────────────────────────────────────
# 这两项由 scripts/setup-dingtalk.sh 自动写入，一般不用手填。
# 如果是在钉钉开放平台网页上手动创建的应用，从「凭证与基础信息」页面复制：
#   Client ID     = 老文档里的 AppKey
#   Client Secret = 老文档里的 AppSecret
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# ── 大模型配置 ───────────────────────────────────────────
# 支持 OpenAI 官方，以及任何兼容 OpenAI Chat Completions 协议的服务。
#
# OpenAI 官方示例：
#   MODEL_BASE_URL=https://api.openai.com/v1
#   MODEL_NAME=gpt-4.1-mini
#
# 第三方 / 自建网关示例：
#   MODEL_BASE_URL=https://你的网关地址/v1
#   MODEL_NAME=你的模型名
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini

# 模型的 API Key
OPENAI_API_KEY=

# ── 可选项 ───────────────────────────────────────────────
# 机器人在回复里显示的名字，留空则用「数字员工」
EMPLOYEE_DISPLAY_NAME=

# 找不到依据时的固定回复语。
# 注意：这句话是【固定文本】，不由模型生成 —— 检索不到证据时原样返回。
# 如果这里写英文，那么无论用户用什么语言提问，转人工提示都会是英文。
ESCALATION_MESSAGE=
